diff --git a/src/termio/Exec.zig b/src/termio/Exec.zig
index 87d47807c..5555db984 100644
--- a/src/termio/Exec.zig
+++ b/src/termio/Exec.zig
@@ -1169,7 +1169,25 @@ const Subprocess = struct {
                     if ((comptime builtin.target.os.tag.isDarwin()) and
                         err == .PERM)
                     {
-                        log.debug("killpg failed with EPERM, expected on Darwin and ignoring", .{});
+                        // On Darwin, killpg fails with EPERM when the child has
+                        // moved itself into a different session via setsid (any
+                        // interactive shell does this). The group signal is then
+                        // never delivered, so the child — and everything it
+                        // spawned — would survive and orphan (reparented to PID
+                        // 1) once we exit. Previously we just logged and ignored
+                        // this, which is why closed surfaces leaked their shells.
+                        // Fall back to signaling the direct child by pid: a clean
+                        // SIGHUP lets it run its exit hooks and reap its own
+                        // descendants. The loop/waitpid below keeps going until
+                        // it's actually gone.
+                        switch (posix.errno(c.kill(pid, c.SIGHUP))) {
+                            // ESRCH: already gone; waitpid below will reap it.
+                            .SUCCESS, .SRCH => {},
+                            else => |kerr| {
+                                log.warn("error killing child pid={} err={}", .{ pid, kerr });
+                                return error.KillFailed;
+                            },
+                        }
                         break :killpg;
                     }
 
