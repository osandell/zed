index 66b8c6057..edf7797d9 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -775,6 +775,19 @@ foreground: Color = .{ .r = 0xFF, .g = 0xFF, .b = 0xFF },
 /// This value does not apply to Emoji or images.
 @"minimum-contrast": f64 = 1,
 
+/// Adapt a program that draws for a dark terminal to a light background. An
+/// explicit cell color (palette or RGB) that would not read on a light
+/// background has its lightness reflected, keeping hue and chroma, so light
+/// text turns dark and dark highlight backgrounds turn pale. Mid-tone colors
+/// and pale backgrounds are kept as they are. The default foreground and
+/// background are left as configured.
+///
+/// Meant for running every program in its dark theme and letting the terminal
+/// follow a light theme. Pair it with a light `palette`/`theme` whose accents
+/// read on its background (Solarized Light, say) and a light
+/// `background`/`foreground`.
+@"adapt-dark-colors": bool = false,
+
 /// Color palette for the 256 color form that many terminal applications use.
 /// The syntax of this configuration is `N=COLOR` where `N` is 0 to 255 (for
 /// the 256 colors in the terminal color table) and `COLOR` is a typical RGB
diff --git a/src/renderer/adapt.zig b/src/renderer/adapt.zig
new file mode 100644
index 000000000..cd369c820
--- /dev/null
+++ b/src/renderer/adapt.zig
@@ -0,0 +1,155 @@
+//! Adapting the colors of a program written for a dark terminal to a light
+//! one (`adapt-dark-colors`).
+//!
+//! Only colors that would not read on a light background are changed, and
+//! only in OKLab lightness; hue and chroma are kept. Text lighter than
+//! `fg_fold` is reflected about it, so white and light grey text turn dark,
+//! while mid-tone accents (a light palette's, such as Solarized's, or a
+//! dark theme's) are left exactly as they are. Backgrounds darker than the
+//! point where the curve crosses itself are pushed up towards the light
+//! default background, so a dark program's diff lines, selections and status
+//! bars turn into pale tints of the same hue, and light backgrounds stay.
+//! The default foreground and background are left alone: they are the light
+//! theme's own.
+
+const std = @import("std");
+const RGB = @import("../terminal/main.zig").color.RGB;
+
+pub const Role = enum(u1) { fg, bg };
+
+/// A small direct-mapped cache in front of `map`: a frame asks for the same
+/// handful of colors over and over.
+pub const Cache = struct {
+    const size = 512;
+    /// bits 0-23: rgb, bit 24: role, bit 25: valid.
+    keys: [size]u32 = @splat(0),
+    values: [size]RGB = @splat(.{}),
+
+    pub fn get(self: *Cache, rgb: RGB, role: Role) RGB {
+        const key: u32 = @as(u32, rgb.r) << 16 | @as(u32, rgb.g) << 8 | rgb.b |
+            @as(u32, @intFromEnum(role)) << 24 | 1 << 25;
+        const slot = (key *% 2654435761) >> 23 & (size - 1);
+        if (self.keys[slot] == key) return self.values[slot];
+        const value = map(rgb, role);
+        self.keys[slot] = key;
+        self.values[slot] = value;
+        return value;
+    }
+};
+
+/// Text at or below this OKLab lightness already reads on a light background.
+const fg_fold: f32 = 0.65;
+/// The darkest reflected text may get, so white does not land on pure black.
+const fg_floor: f32 = 0.25;
+
+pub fn map(rgb: RGB, role: Role) RGB {
+    const lab = toOklab(rgb);
+    const l: f32 = switch (role) {
+        .fg => if (lab[0] <= fg_fold) return rgb else @max(fg_floor, 2 * fg_fold - lab[0]),
+        .bg => @max(lab[0], 1 - 0.55 * std.math.pow(f32, lab[0], 1.6)),
+    };
+    if (l == lab[0]) return rgb;
+    return fromOklabInGamut(l, lab[1], lab[2]);
+}
+
+fn toLinear(c: u8) f32 {
+    const v = @as(f32, @floatFromInt(c)) / 255;
+    return if (v <= 0.04045) v / 12.92 else std.math.pow(f32, (v + 0.055) / 1.055, 2.4);
+}
+
+fn fromLinear(v: f32) u8 {
+    const c = if (v <= 0.0031308) v * 12.92 else 1.055 * std.math.pow(f32, v, 1.0 / 2.4) - 0.055;
+    return @intFromFloat(@round(std.math.clamp(c, 0, 1) * 255));
+}
+
+fn toOklab(rgb: RGB) [3]f32 {
+    const r = toLinear(rgb.r);
+    const g = toLinear(rgb.g);
+    const b = toLinear(rgb.b);
+    const l = std.math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+    const m = std.math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+    const s = std.math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+    return .{
+        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
+    };
+}
+
+fn oklabToLinear(l: f32, a: f32, b: f32) [3]f32 {
+    const l_ = l + 0.3963377774 * a + 0.2158037573 * b;
+    const m_ = l - 0.1055613458 * a - 0.0638541728 * b;
+    const s_ = l - 0.0894841775 * a - 1.2914855480 * b;
+    const l3 = l_ * l_ * l_;
+    const m3 = m_ * m_ * m_;
+    const s3 = s_ * s_ * s_;
+    return .{
+        4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
+        -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
+        -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3,
+    };
+}
+
+fn inGamut(c: [3]f32) bool {
+    const eps = 0.0001;
+    for (c) |v| if (v < -eps or v > 1 + eps) return false;
+    return true;
+}
+
+/// Converts back to sRGB, reducing chroma (never lightness or hue) until the
+/// color fits.
+fn fromOklabInGamut(l_in: f32, a: f32, b: f32) RGB {
+    const l = std.math.clamp(l_in, 0, 1);
+    var c = oklabToLinear(l, a, b);
+    if (!inGamut(c)) {
+        var lo: f32 = 0;
+        var hi: f32 = 1;
+        for (0..12) |_| {
+            const mid = (lo + hi) / 2;
+            if (inGamut(oklabToLinear(l, a * mid, b * mid))) lo = mid else hi = mid;
+        }
+        c = oklabToLinear(l, a * lo, b * lo);
+    }
+    return .{ .r = fromLinear(c[0]), .g = fromLinear(c[1]), .b = fromLinear(c[2]) };
+}
+
+test "light text turns dark, dark backgrounds turn pale" {
+    const testing = std.testing;
+    const white = map(.{ .r = 255, .g = 255, .b = 255 }, .fg);
+    try testing.expect(white.r < 70 and white.g < 70 and white.b < 70);
+
+    // Solarized Light's base3, its palette 15, becomes readable text.
+    const base3 = map(.{ .r = 0xfd, .g = 0xf6, .b = 0xe3 }, .fg);
+    try testing.expect(base3.r < 90);
+
+    // A dark red diff background becomes a pale red.
+    const red_bg = map(.{ .r = 92, .g = 24, .b = 32 }, .bg);
+    try testing.expect(red_bg.r > 200 and red_bg.r > red_bg.g and red_bg.r > red_bg.b);
+
+    // Black background stays next to white.
+    const black_bg = map(.{ .r = 0, .g = 0, .b = 0 }, .bg);
+    try testing.expect(black_bg.r > 250);
+}
+
+test "colors that already read on a light background are kept" {
+    const testing = std.testing;
+    // Solarized accents: blue, red, green, cyan.
+    for ([_]RGB{
+        .{ .r = 0x26, .g = 0x8b, .b = 0xd2 },
+        .{ .r = 0xdc, .g = 0x32, .b = 0x2f },
+        .{ .r = 0x85, .g = 0x99, .b = 0x00 },
+        .{ .r = 0x2a, .g = 0xa1, .b = 0x98 },
+    }) |accent| try testing.expectEqual(accent, map(accent, .fg));
+
+    // A pale background stays pale.
+    const pale: RGB = .{ .r = 0xee, .g = 0xe8, .b = 0xd5 };
+    try testing.expectEqual(pale, map(pale, .bg));
+}
+
+test "cache returns what map returns" {
+    var cache: Cache = .{};
+    const c: RGB = .{ .r = 12, .g = 200, .b = 99 };
+    try std.testing.expectEqual(map(c, .fg), cache.get(c, .fg));
+    try std.testing.expectEqual(map(c, .fg), cache.get(c, .fg));
+    try std.testing.expectEqual(map(c, .bg), cache.get(c, .bg));
+}
