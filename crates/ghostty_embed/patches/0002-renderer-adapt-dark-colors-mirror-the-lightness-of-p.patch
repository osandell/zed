 /// the 256 colors in the terminal color table) and `COLOR` is a typical RGB
diff --git a/src/renderer/adapt.zig b/src/renderer/adapt.zig
new file mode 100644
index 000000000..b9cda6b3d
--- /dev/null
+++ b/src/renderer/adapt.zig
@@ -0,0 +1,131 @@
+//! Adapting the colors of a program written for a dark terminal to a light
+//! one (`adapt-dark-colors`).
+//!
+//! Every explicit cell color (palette or RGB) gets its OKLab lightness
+//! mirrored while hue and chroma are kept, so a dark program's light text
+//! turns dark and its dark highlight backgrounds (diff lines, selections,
+//! status bars) turn into pale tints of the same hue. The default foreground
+//! and background are left alone: they are the light theme's own.
+//!
+//! Backgrounds and foregrounds use different curves. Text is mirrored into
+//! 0.2-0.8 rather than 0-1, so white text lands on near-black and an accent
+//! color keeps enough lightness to still read as its hue. A dark program's backgrounds sit just above its dark default
+//! background, and mirrored linearly they would end up mid-grey, so they are
+//! pushed up towards the light default background instead.
+
+const std = @import("std");
+const RGB = @import("../terminal/main.zig").color.RGB;
+
+pub const Role = enum(u1) { fg, bg };
+
+/// A small direct-mapped cache in front of `map`: a frame asks for the same
+/// handful of colors over and over.
+pub const Cache = struct {
+    const size = 512;
+    /// bits 0-23: rgb, bit 24: role, bit 25: valid.
+    keys: [size]u32 = @splat(0),
+    values: [size]RGB = @splat(.{}),
+
+    pub fn get(self: *Cache, rgb: RGB, role: Role) RGB {
+        const key: u32 = @as(u32, rgb.r) << 16 | @as(u32, rgb.g) << 8 | rgb.b |
+            @as(u32, @intFromEnum(role)) << 24 | 1 << 25;
+        const slot = (key *% 2654435761) >> 23 & (size - 1);
+        if (self.keys[slot] == key) return self.values[slot];
+        const value = map(rgb, role);
+        self.keys[slot] = key;
+        self.values[slot] = value;
+        return value;
+    }
+};
+
+pub fn map(rgb: RGB, role: Role) RGB {
+    const lab = toOklab(rgb);
+    const l: f32 = switch (role) {
+        .fg => 0.2 + 0.6 * (1 - lab[0]),
+        .bg => 1 - 0.55 * std.math.pow(f32, lab[0], 1.6),
+    };
+    return fromOklabInGamut(l, lab[1], lab[2]);
+}
+
+fn toLinear(c: u8) f32 {
+    const v = @as(f32, @floatFromInt(c)) / 255;
+    return if (v <= 0.04045) v / 12.92 else std.math.pow(f32, (v + 0.055) / 1.055, 2.4);
+}
+
+fn fromLinear(v: f32) u8 {
+    const c = if (v <= 0.0031308) v * 12.92 else 1.055 * std.math.pow(f32, v, 1.0 / 2.4) - 0.055;
+    return @intFromFloat(@round(std.math.clamp(c, 0, 1) * 255));
+}
+
+fn toOklab(rgb: RGB) [3]f32 {
+    const r = toLinear(rgb.r);
+    const g = toLinear(rgb.g);
+    const b = toLinear(rgb.b);
+    const l = std.math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+    const m = std.math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+    const s = std.math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+    return .{
+        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
+    };
+}
+
+fn oklabToLinear(l: f32, a: f32, b: f32) [3]f32 {
+    const l_ = l + 0.3963377774 * a + 0.2158037573 * b;
+    const m_ = l - 0.1055613458 * a - 0.0638541728 * b;
+    const s_ = l - 0.0894841775 * a - 1.2914855480 * b;
+    const l3 = l_ * l_ * l_;
+    const m3 = m_ * m_ * m_;
+    const s3 = s_ * s_ * s_;
+    return .{
+        4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
+        -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
+        -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3,
+    };
+}
+
+fn inGamut(c: [3]f32) bool {
+    const eps = 0.0001;
+    for (c) |v| if (v < -eps or v > 1 + eps) return false;
+    return true;
+}
+
+/// Converts back to sRGB, reducing chroma (never lightness or hue) until the
+/// color fits.
+fn fromOklabInGamut(l_in: f32, a: f32, b: f32) RGB {
+    const l = std.math.clamp(l_in, 0, 1);
+    var c = oklabToLinear(l, a, b);
+    if (!inGamut(c)) {
+        var lo: f32 = 0;
+        var hi: f32 = 1;
+        for (0..12) |_| {
+            const mid = (lo + hi) / 2;
+            if (inGamut(oklabToLinear(l, a * mid, b * mid))) lo = mid else hi = mid;
+        }
+        c = oklabToLinear(l, a * lo, b * lo);
+    }
+    return .{ .r = fromLinear(c[0]), .g = fromLinear(c[1]), .b = fromLinear(c[2]) };
+}
+
+test "light text turns dark, dark backgrounds turn pale" {
+    const testing = std.testing;
+    const white = map(.{ .r = 255, .g = 255, .b = 255 }, .fg);
+    try testing.expect(white.r < 40 and white.g < 40 and white.b < 40);
+
+    // A dark red diff background becomes a pale red.
+    const red_bg = map(.{ .r = 92, .g = 24, .b = 32 }, .bg);
+    try testing.expect(red_bg.r > 200 and red_bg.r > red_bg.g and red_bg.r > red_bg.b);
+
+    // Black background stays next to white.
+    const black_bg = map(.{ .r = 0, .g = 0, .b = 0 }, .bg);
+    try testing.expect(black_bg.r > 250);
+}
+
+test "cache returns what map returns" {
+    var cache: Cache = .{};
+    const c: RGB = .{ .r = 12, .g = 200, .b = 99 };
+    try std.testing.expectEqual(map(c, .fg), cache.get(c, .fg));
+    try std.testing.expectEqual(map(c, .fg), cache.get(c, .fg));
+    try std.testing.expectEqual(map(c, .bg), cache.get(c, .bg));
+}
